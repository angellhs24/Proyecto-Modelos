{
  "name": "ecosistema-podologia",
  "version": "2.0.0",
  "description": "Ecosistema de Gestión Médica, Portal Administrativo y Agendamiento Público para Podología",
  "main": "backend/src/app.js",
  "scripts": {
    "start": "node backend/src/app.js",
    "dev": "node --watch backend/src/app.js",
    "dev:backend": "cd backend && npm run dev",
    "dev:admin": "cd frontend-admin && npm start",
    "dev:landing": "cd frontend-landing && npm start",
    "test:backend": "cd backend && npm run test:rbac",
    "test:admin": "cd frontend-admin && npm run test:unit",
    "install:all": "npm --prefix backend install && npm --prefix frontend-admin install"
  },
  "keywords": [
    "podologia",
    "clinica",
    "gestion-medica",
    "landing",
    "rbac"
  ],
  "author": "Angel Hdez",
  "license": "ISC"
}
